{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "testRunner": "jest",
    "jest": {
        "projectType": "custom",
        "configFile": "package.json",
        "enableFindRelatedTests": true
    },
    "mutate": [
        "src/application/services/AuthService.ts",
        "src/application/use-cases/commands/blog/CreateBlogCommand.ts",
        "src/application/use-cases/commands/blog/UpdateBlogCommand.ts",
        "src/application/use-cases/commands/contact/SubmitContactCommand.ts",
        "src/domain/value-objects/Slug.ts",
        "src/domain/value-objects/Email.ts",
        "src/domain/value-objects/DateRange.ts",
        "src/infrastructure/cache/CacheQueryService.ts",
        "src/infrastructure/cache/CacheInvalidationService.ts",
        "src/infrastructure/database/tasks/TokenCleanupTask.ts",
        "src/interface-adapters/filters/DomainExceptionFilter.ts"
    ],
    "testRunner_comment": "Only mutate files that have corresponding spec files",
    "reporters": ["html", "clear-text", "progress"],
    "htmlReporter": {
        "fileName": "reports/mutation/mutation.html"
    },
    "thresholds": {
        "high": 80,
        "low": 60,
        "break": 50
    },
    "concurrency": 2,
    "timeoutMS": 10000,
    "timeoutFactor": 2.5,
    "disableTypeChecks": true,
    "coverageAnalysis": "perTest"
}