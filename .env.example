# ====================== APP CONFIG ======================
NODE_ENV=development
PORT=3001

# ====================== DATABASE ======================
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/portfolio?schema=public
# Connection pool size — default 10. Lower on free-tier PaaS (e.g. 3 on Render free).
DATABASE_POOL_SIZE=10

# ====================== FRONTEND ======================
FRONTEND_URL=http://localhost:3000,https://localhost:3000,https://yourdomain.com

# ====================== AUTH ======================
JWT_SECRET=your_super_long_random_jwt_secret_here_at_least_64_characters

ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=change_this_in_production_make_it_very_strong

# Fingerprint protection (recommended: true)
FINGERPRINT_STRICT=true

# ====================== SECURITY ======================
COOKIE_SECRET=your_very_long_random_cookie_secret_here_at_least_64_characters

# ====================== HTTPS ======================
USE_HTTPS=false
# Only needed when USE_HTTPS=true
# CERT_KEY_PATH=./certificates/key.pem
# CERT_CERT_PATH=./certificates/cert.pem

# ====================== CACHE ======================
# Currently using in-memory cache — no Redis required.
# To switch to Redis: uncomment below + the two lines in ConfigValidationService + follow app.module.ts steps.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ====================== ANTI-BOT ======================
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# ====================== EMAIL ======================
RESEND_API_KEY=your_resend_api_key_here
# Must be a verified sender domain in production (not onboarding@resend.dev)
# Example: Portfolio <hello@yourdomain.com>
RESEND_FROM_ADDRESS=Portfolio <onboarding@resend.dev>

# ====================== SPOTIFY (Optional) ======================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

# ====================== OPTIONAL / FUTURE ======================
# GOOGLE_ANALYTICS_ID=
# UPLOADTHING_SECRET=