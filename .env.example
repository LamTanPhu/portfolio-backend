# ====================== DATABASE ======================
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/portfolio

# ====================== APP CONFIG ======================
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# ====================== AUTH ======================
JWT_SECRET=change_me_in_production_please_make_this_long_and_random
ADMIN_EMAIL=your@email.com
ADMIN_PASSWORD=change_me_in_production

FINGERPRINT_STRICT=TRUE # Set to TRUE to enable strict fingerprinting (more secure, but may cause issues with some clients)
# ====================== SECURITY ======================
COOKIE_SECRET=your_very_long_random_cookie_secret_here

# ====================== EXTERNAL SERVICES ======================
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token

RESEND_API_KEY=your_resend_api_key_here

# ====================== OPTIONAL / FUTURE ======================
# GOOGLE_ANALYTICS_ID=
# UPLOADTHING_SECRET=
# etc.