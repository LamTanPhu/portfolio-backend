# Copy to .env.docker and fill in. NEVER commit .env.docker.
# No inline comments after values (compose env_file parsing) — comments go on their own line.

# ---- Postgres container ----
POSTGRES_USER=portfolio
# Use hex to avoid URL-escaping problems:  openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_hex_only
POSTGRES_DB=portfolio

# ---- App -> DB (host is the compose service name "db", NOT localhost) ----
# Password here MUST match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://portfolio:CHANGE_ME_hex_only@db:5432/portfolio?schema=public
DATABASE_POOL_SIZE=5

# ---- App ----
NODE_ENV=production
PORT=3001
# Comma-separated, exact origins of your frontend
FRONTEND_URL=http://localhost:3000
# 0 = no reverse proxy in front (direct port mapping). Set 1 behind Caddy/Cloudflare/Render.
TRUST_PROXY_HOPS=0
USE_HTTPS=false

# ---- Auth / secrets (openssl rand -hex 48) ----
JWT_SECRET=CHANGE_ME
COOKIE_SECRET=CHANGE_ME
SNAKE_CAPTCHA_SECRET=CHANGE_ME
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=CHANGE_ME_strong
FINGERPRINT_STRICT=true

# ---- Third-party (required by startup validation) ----
# Cloudflare test secret that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
RESEND_API_KEY=re_CHANGE_ME
RESEND_FROM_ADDRESS=Portfolio <onboarding@resend.dev>

# ---- Optional ----
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REFRESH_TOKEN=
